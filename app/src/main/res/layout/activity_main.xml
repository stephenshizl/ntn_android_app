<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_disconnected"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/deviceSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp" />

        <LinearLayout
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/refreshButton"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/refresh_paired" />

            <Button
                android:id="@+id/connectButton"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/connect" />

            <Button
                android:id="@+id/disconnectButton"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/disconnect" />
        </LinearLayout>

        <Button
            android:id="@+id/bluetoothSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_bt_settings" />

        <Button android:id="@+id/bluetoothOtaButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/ota_title" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="vertical"
            android:background="#EDF1FA" android:padding="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/bt_name_title" android:textStyle="bold" android:textSize="18sp" />
            <TextView android:id="@+id/btNameStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/bt_name_disconnected" />
            <TextView android:id="@+id/btNameValue" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textIsSelectable="true" />
            <TextView android:id="@+id/btIdentityValue" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textIsSelectable="true" />
            <EditText android:id="@+id/btNameEdit" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="@string/bt_name_validation"
                android:inputType="textVisiblePassword" android:singleLine="true" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btNameQueryButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/bt_name_query" />
                <Button android:id="@+id/btNameSetButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/bt_name_set" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btNameAutoButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/bt_name_auto" />
                <Button android:id="@+id/btNameRefreshButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/bt_name_refresh" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bt_name_hint" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="vertical"
            android:background="#E8F4F3" android:padding="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/gnss_title" android:textSize="18sp" android:textStyle="bold" android:textColor="#12343B" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/gnss_source" android:textSize="12sp" android:textColor="#12343B" />
            <TextView android:id="@+id/gnssStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textColor="#12343B" android:textIsSelectable="true" />
            <TextView android:id="@+id/gnssCoordinates" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textColor="#12343B" android:textIsSelectable="true" />
            <TextView android:id="@+id/gnssSatellites" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textColor="#12343B" android:textIsSelectable="true" />
            <TextView android:id="@+id/gnssConstellations" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textColor="#12343B" android:textIsSelectable="true" />
            <TextView android:id="@+id/gnssMotion" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textColor="#12343B" android:textIsSelectable="true" />
            <TextView android:id="@+id/gnssUtc" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textColor="#12343B" android:textIsSelectable="true" />
            <TextView android:id="@+id/gnssAge" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textColor="#12343B" android:textIsSelectable="true" />
            <TextView android:id="@+id/gnssUpdated" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textColor="#12343B" android:textIsSelectable="true" />
            <CheckBox android:id="@+id/gnssAutoRefresh" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:checked="true"
                android:text="@string/gnss_auto" android:textColor="#12343B" />
            <Button android:id="@+id/gnssRefreshButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/gnss_refresh" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/quick_queries"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2">

            <Button
                android:id="@+id/versionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/query_version" />

            <Button
                android:id="@+id/statusButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/query_status" />

            <Button
                android:id="@+id/gnssButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/query_gnss" />

            <Button
                android:id="@+id/timeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/query_time" />

            <Button
                android:id="@+id/mode0Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/mode0" />

            <Button
                android:id="@+id/mode1Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/mode1" />
        </GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/baudSpinner"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/setBaudButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set_baud" />
        </LinearLayout>

        <EditText
            android:id="@+id/localCommandEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/local_at_hint"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:singleLine="true" />

        <Button
            android:id="@+id/sendLocalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/send_mcu_at" />

        <EditText
            android:id="@+id/ntnCommandEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ntn_at_hint"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:singleLine="true" />

        <Button
            android:id="@+id/sendNtnButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/send_ntn_at" />

        <Button
            android:id="@+id/clearLogButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clear_log" />

        <ScrollView android:id="@+id/logScroll" android:layout_width="match_parent"
            android:layout_height="240dp" android:nestedScrollingEnabled="true">
        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#101820"
            android:fontFamily="monospace"
            android:minHeight="260dp"
            android:padding="10dp"
            android:textColor="#E8F1F2"
            android:textIsSelectable="true"
            android:textSize="12sp" />
        </ScrollView>
    </LinearLayout>
</ScrollView>
